[Unit]
Description=kidandcat.com /up file drop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=debian
Group=debian
WorkingDirectory=/opt/kidandcat-up
ExecStart=/opt/kidandcat-up/kidandcat-up
Environment=KIDANDCAT_UP_DIR=/var/lib/kidandcat-up
Environment=KIDANDCAT_UP_LISTEN=127.0.0.1:8098
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=256M
MemorySwapMax=0
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
